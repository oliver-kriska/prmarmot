#!/bin/sh
# PR Marmot pre-commit hook — the fast quality gate (fmt + clippy + tests of the
# GPUI-free crates: prmarmot-core, prmarmot-local, prmarmot-cli).
# Mirrors CI. Runs only when Rust/Cargo files are staged, so docs-only commits
# (CLAUDE.md, HANDOFF.md, …) stay instant.
#
# Bypass:  git commit --no-verify   |   PRMARMOT_SKIP_HOOKS=1 git commit …
# Install: make hooks   (sets core.hooksPath to .githooks)

set -eu

if [ -n "${PRMARMOT_SKIP_HOOKS:-}" ]; then
  echo "pre-commit: skipped (PRMARMOT_SKIP_HOOKS set)"
  exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if ! printf '%s\n' "$staged" | grep -qE '\.rs$|(^|/)Cargo\.(toml|lock)$'; then
  echo "pre-commit: no Rust changes staged — skipping fmt/clippy/test"
  exit 0
fi

echo "pre-commit: cargo fmt --check"
if ! cargo fmt --check; then
  echo >&2
  echo "  Formatting issues above. Run 'make fmt' and re-stage." >&2
  exit 1
fi

crates="-p prmarmot-core -p prmarmot-local -p prmarmot-cli"

echo "pre-commit: cargo clippy (core, local, cli) -D warnings"
# shellcheck disable=SC2086
cargo clippy $crates --all-targets -- -D warnings

echo "pre-commit: cargo test (core, local, cli)"
# shellcheck disable=SC2086
cargo test $crates --quiet

echo "pre-commit: OK"
