def page(nodes, next_cursor=None):
    """One page of a search.

    `next_cursor` both says there is more and names the fixture file that holds
    it: the scenario writer emits `<cursor>.json`, and the fake GitHub in the
    iPad's test bundle serves whatever file the `after` variable names. The
    cursor is the file name, so the two cannot disagree.
    """
    return {
        "pageInfo": {"hasNextPage": next_cursor is not None, "endCursor": next_cursor},
        "nodes": nodes,
    }


# --- Scenarios -------------------------------------------------------------
#
# A scenario is an ordered list of refreshes. The iPad's tests replay them in
# order, which is the only way to test anything that is a change rather than a
# state: the blue "changed" marker, a snooze waking, a watched PR being merged,
# CI going red then green. Each step is a function that edits a fresh copy of
# the fixture data; `--fixtures DIR` writes every step of every scenario as the
# JSON GitHub would have answered with.
#
# Timestamps come from `ago()`, so pin the clock with PRMARMOT_DEMO_NOW before
# writing fixtures or they will differ on every run.


def views_copy():
    """A private copy of the three node lists.

    One `deepcopy` call for all three, because AVAILABLE deliberately shares a
    node with REQUESTED (a PR requested from you also appearing in the broad
    search) and copying them separately would quietly break that.
    """
    return copy.deepcopy({"authored": AUTHORED, "requested": REQUESTED,
                          "available": AVAILABLE})


def find(views, number):
    for nodes in views.values():
        for node in nodes:
            if node["number"] == number:
                return node
    raise KeyError(f"no fixture PR {number}")


def set_ci(node, state):
    rollup = None if state is None else {"state": state}
    node["commits"]["nodes"][0]["commit"]["statusCheckRollup"] = rollup


def push_commit(node, tag="next"):
    """A new head commit: what "New commits" is computed from."""
    node["headRefOid"] = f"{node['headRefOid']}-{tag}"
    node["updatedAt"] = ago(0)


def add_review(node, login, state, hours=1):
    node["reviews"]["nodes"].append(
        {"author": {"login": login}, "state": state, "submittedAt": ago(hours)})
    node["updatedAt"] = ago(0)


def request_review(node, login):
    reviewer = {"__typename": "User", "login": login}
    node["reviewRequests"]["nodes"].append({"requestedReviewer": reviewer})
    node["reviewRequests"]["totalCount"] = len(node["reviewRequests"]["nodes"])
    node["timelineItems"]["nodes"].append(
        {"__typename": "ReviewRequestedEvent", "createdAt": ago(1),
         "requestedReviewer": reviewer})


def resolve_threads(node):
    node["reviewThreads"]["nodes"] = []


def leave_board(views, number, *, merged):
    """The PR is merged or closed, so the search stops returning it.

    It stays in the step's node index, which is how a watched PR that has left
    the board still comes back through the `tracked` alias.
    """
    node = find(views, number)
    node["state"] = "MERGED" if merged else "CLOSED"
    node["merged"] = merged
    for alias, nodes in views.items():
        views[alias] = [item for item in nodes if item["number"] != number]
    return node


def extra_rows(alias, first_number, count):
    """Filler rows for a multi-page scenario: enough to tell pages apart."""
    return [
        pr(first_number + index,
           f"Page filler {first_number + index}: tighten {SCALE_WORDS[index % len(SCALE_WORDS)]}",
           author="demo-user" if alias == "authored" else f"dev{index % 5}",
           labels=(SCALE_LABELS[index % len(SCALE_LABELS)],),
           requested=("demo-user",) if alias == "requested" else (),
           waited=(index * 9) % 120,
           repo=("demo-labs/atlas", "demo-labs/mobile")[index % 2])
        for index in range(count)
    ]


def _changed_second(views):
    # A red build turns green, a PR gets new commits, and somebody reviews.
    set_ci(find(views, 418), "SUCCESS")
    push_commit(find(views, 417))
    add_review(find(views, 528), "taylor", "COMMENTED")


def _changed_third(views):
    _changed_second(views)
    # Then a reviewer is added and the open threads are resolved.
    request_review(find(views, 418), "sam")
    resolve_threads(find(views, 418))
    push_commit(find(views, 416), "third")


def _snooze_waiting(views):
    # Armed: the build this PR is snoozed on has not finished.
    set_ci(find(views, 524), "PENDING")


def _snooze_still_waiting(views):
    _snooze_waiting(views)
    find(views, 524)["updatedAt"] = ago(0)


def _snooze_finished(views):
    # Terminal, and different from the baseline: this is what wakes it.
    set_ci(find(views, 524), "FAILURE")
    add_review(find(views, 528), "river", "APPROVED")


def _watch_merged(views):
    leave_board(views, 418, merged=True)


def _empty(views):
    for alias in views:
        views[alias] = []


SCENARIOS = {
    "steady": {
        "description": "One refresh of both views: stacks, size bands, a stale PR, a draft.",
        "steps": [None],
    },
    "changed": {
        "description": "Three refreshes: CI goes green, commits land, a review arrives, "
                       "then a reviewer is added and threads are resolved.",
        "steps": [None, _changed_second, _changed_third],
    },
    "paged": {
        "description": "An authored search with three pages, for Load more.",
        "steps": [None],
        "pages": {"authored": [("p2", 700), ("p3", 800)]},
    },
    "deep": {
        "description": "Six authored pages, so Load more can be driven past core's "
                       "five-page cap: the sixth is never fetched.",
        "steps": [None],
        "pages": {"authored": [("p2", 700), ("p3", 800), ("p4", 900), ("p5", 1000),
                               ("p6", 1100)]},
    },
    "snoozing": {
        "description": "A PR snoozed on its build: pending, still pending, then failing.",
        "steps": [_snooze_waiting, _snooze_still_waiting, _snooze_finished],
    },
    "watching": {
        "description": "A watched PR is merged and leaves the board, but is still tracked.",
        "steps": [None, _watch_merged],
    },
    "empty": {
        "description": "Both views empty, for the empty states.",
        "steps": [_empty],
    },
}


def scenario_step(name, step):
    """The node lists for one refresh, plus every node by id for `tracked`."""
    scenario = SCENARIOS[name]
    views = views_copy()
    index = {node["id"]: node for nodes in views.values() for node in nodes}
    mutate = scenario["steps"][step - 1]
    if mutate is not None:
        mutate(views)
    # Nodes that left the board are still answerable by id.
    for nodes in views.values():
        for node in nodes:
            index[node["id"]] = node
    return views, index


def scenario_files(name, step):
    """`{filename: body}` for one refresh of one scenario."""
    views, index = scenario_step(name, step)
    pages = SCENARIOS[name].get("pages", {})
    files = {}

    def cursor_for(alias, position):
        names = pages.get(alias, [])
        return f"{alias}-{names[position][0]}" if position < len(names) else None

    authored_cursor = cursor_for("authored", 0)
    files[f"step{step}-authored.json"] = {
        "data": {"search": page(views["authored"], authored_cursor), "rateLimit": rate(3)}
    }
    requested_cursor = cursor_for("requested", 0)
    files[f"step{step}-review.json"] = {
        "data": {
            "requested": page(views["requested"], requested_cursor),
            "available": page(views["available"], cursor_for("available", 0)),
            "rateLimit": rate(5),
        }
    }
    for alias, extra in pages.items():
        for position, (suffix, first_number) in enumerate(extra):
            nodes = extra_rows(alias, first_number, 6)
            for node in nodes:
                index[node["id"]] = node
            body_key = "search" if alias == "authored" else alias
            body = {body_key: page(nodes, cursor_for(alias, position + 1)),
                    "rateLimit": rate(3)}
            if alias != "authored":
                other = "available" if alias == "requested" else "requested"
                body[other] = page([], None)
            files[f"step{step}-{alias}-{suffix}.json"] = {"data": body}
    # Every node this refresh knows about, so the fake can answer a `tracked`
    # request for a PR that is no longer in either search.
    files[f"step{step}-nodes.json"] = index
    return files


def write_fixtures(root):
    """Write every scenario under `root`, one directory each."""
    root = Path(root)
    written = []
    for name, scenario in SCENARIOS.items():
        directory = root / name
        directory.mkdir(parents=True, exist_ok=True)
        steps = len(scenario["steps"])
        for step in range(1, steps + 1):
            for filename, body in scenario_files(name, step).items():
                path = directory / filename
                path.write_text(json.dumps(body, indent=2, sort_keys=True) + "\n")
                written.append(path)
        manifest = {
            "name": name,
            "description": scenario["description"],
            "steps": steps,
            "nowEpoch": int(now().timestamp()),
            "now": now().strftime("%Y-%m-%dT%H:%M:%SZ"),
        }
        path = directory / "manifest.json"
        path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
        written.append(path)
    # The REST walk behind the repository picker, shared by every scenario.
    repos = [{"full_name": name} for name in (
        "demo-labs/atlas", "demo-labs/mobile", "demo-labs/web", "demo-labs/infra",
        "demo-labs/docs", "demo-labs/design-system", "demo-labs/billing",
        "demo-labs/analytics", "acme/widgets", "acme/api", "acme/legacy",
        "personal/dotfiles")]
    path = root / "repos.json"
    path.write_text(json.dumps(repos, indent=2) + "\n")
    written.append(path)
    return written


# PRMARMOT_DEMO_ROWS=N: N fictional PRs per search, 60 per page, for measuring
# the table at Load-more size. Unset, the screenshot fixtures above are served.
SCALE_PAGE = 60
SCALE_WORDS = ("cache", "sync", "export", "search", "timeline", "session", "import",
               "notification", "workspace", "renderer", "keymap", "settings")
SCALE_LABELS = ("bug", "feature", "docs", "mobile", "performance", "area:ui",
                "area:sync", "needs review", "cla-signed", "good first issue")


def scale_rows():
    try:
        return max(0, int(os.environ.get("PRMARMOT_DEMO_ROWS", "")))
    except ValueError:
        return 0


def scale_nodes(alias, count):
    base = {"authored": 1000, "requested": 3000, "available": 5000}[alias]
    nodes = []
    for i in range(count):
        word = SCALE_WORDS[i % len(SCALE_WORDS)]
        title = f"{word.capitalize()}: {'tighten ' * (i % 4)}handling for case {i}"
        if i % 7 == 0:
            title += " when the connection drops halfway through a long batch"
        nodes.append(pr(
            base + i, title,
            author="demo-user" if alias == "authored" else f"dev{i % 23}",
            draft=i % 17 == 0,
            decision=("APPROVED" if i % 5 == 0 else "CHANGES_REQUESTED" if i % 11 == 0
                      else "REVIEW_REQUIRED"),
            mergeable="CONFLICTING" if i % 13 == 0 else "MERGEABLE",
            labels=tuple(SCALE_LABELS[(i + k) % len(SCALE_LABELS)] for k in range(i % 5)),
            requested={"requested": ("demo-user",), "available": ()}.get(
                alias, ("alex",) if i % 3 else ()),
            reviews=(("sam", "COMMENTED"),) if i % 4 == 0 else (),
            unresolved=i % 6 if i % 6 < 3 else 0,
            ci=("SUCCESS", "FAILURE", "PENDING", None)[i % 4],
            stack=((900 + i // 3, i % 3 + 1) if alias == "authored" and i % 9 < 3 else None),
            repo=("demo-labs/atlas", "demo-labs/mobile", "demo-labs/web")[i % 3],
            waited=(i * 7) % 150,
            size=((i * 53) % 700, (i * 11) % 150, i % 45 + 1),
        ))
        if nodes[-1]["stack"]:
            nodes[-1]["stack"]["number"] = 900 + i // 9
    return nodes


def scale_page(alias, after):
    nodes = scale_nodes(alias, scale_rows())
    start = int(after[1:]) if after and after.startswith("c") else 0
    end = start + SCALE_PAGE
    more = end < len(nodes)
    return {"pageInfo": {"hasNextPage": more, "endCursor": f"c{end}" if more else None},
            "nodes": nodes[start:end]}


def scale_graphql(query, fields):
    data = {"rateLimit": rate(3)}
    aliases = [alias for alias in ("requested", "available") if f"{alias}: search" in query]
    for alias in aliases:
        after = fields.get(f"{alias}After", fields.get("after") if len(aliases) == 1 else None)
        data[alias] = scale_page(alias, after)
    if not aliases and "search(query:$q" in query:
        data["search"] = scale_page("authored", fields.get("after"))
    if "$tracked" in query:
        data["tracked"] = []
    return {"data": data}


def rate(cost):
    return {"limit": 5000, "cost": cost, "remaining": 4937,
            "resetAt": "2026-09-08T18:00:00Z"}


def graphql(args):
    fields = dict(arg.split("=", 1) for i, arg in enumerate(args)
                  if i and args[i - 1] == "-f" and "=" in arg)
    query = fields.get("query", "")
    tracked_ids = [
        arg.split("=", 1)[1]
        for i, arg in enumerate(args)
        if i and args[i - 1] == "-F" and arg.startswith("tracked[]=")
    ]
    all_nodes = AUTHORED + REQUESTED + AVAILABLE
    tracked = [next((node for node in all_nodes if node["id"] == tracked_id), None)
               for tracked_id in tracked_ids]
    if scale_rows() and "search" in query:
        return scale_graphql(query, fields)
    search = fields.get("q", fields.get("requested", ""))
    selected_repo = next((part[5:] for part in search.split() if part.startswith("repo:")), None)
    def scoped(nodes):
        return [node for node in nodes
                if selected_repo is None or node["repository"]["nameWithOwner"] == selected_repo]
    if "requested:" in query or "requested: search" in query:
        data = {"rateLimit": rate(5)}
        if "$requested" in query:
            data["requested"] = page(scoped(REQUESTED))
        if "$available" in query:
            data["available"] = page(scoped(AVAILABLE))
        if "$tracked" in query:
            data["tracked"] = tracked
        return {"data": data}
    if "search(query:$q" in query:
        data = {"search": page(scoped(AUTHORED)), "rateLimit": rate(3)}
        if "$tracked" in query:
            data["tracked"] = tracked
        return {"data": data}
    # `prmarmot-cli watch --pr`: resolve owner/name#number, then follow it.
    if "pullRequest(number:" in query:
        repo = f"{fields.get('owner')}/{fields.get('name')}"
        number = int(query.split("pullRequest(number:", 1)[1].split(")", 1)[0])
        if not any(node["repository"]["nameWithOwner"] == repo for node in all_nodes):
            return {"data": {"repository": None},
                    "errors": [{"type": "NOT_FOUND", "path": ["repository"],
                                "message": f"Could not resolve to a Repository with the name '{repo}'."}]}
        found = next((node for node in all_nodes
                      if node["repository"]["nameWithOwner"] == repo and node["number"] == number), None)
        if found is None:
            return {"data": {"repository": {"pullRequest": None}},
                    "errors": [{"type": "NOT_FOUND", "path": ["repository", "pullRequest"],
                                "message": f"Could not resolve to a PullRequest with the number of {number}."}]}
        return {"data": {"repository": {"pullRequest": {"id": found["id"]}}}}
    if "$tracked" in query and "search" not in query:
        return {"data": {"rateLimit": rate(1), "tracked": tracked}}
    raise ValueError("unrecognized GraphQL operation")


class FixtureTests(unittest.TestCase):
    def test_numbers_are_unique_and_views_are_distinct(self):
        authored = {item["number"] for item in AUTHORED}
        review = {item["number"] for item in REQUESTED + AVAILABLE}
        self.assertEqual(len(authored), 11)
        self.assertTrue(authored.isdisjoint(review))

    def test_native_stack_has_three_ordered_layers(self):
        layers = [item for item in AUTHORED if item["stack"]]
        self.assertEqual([item["stackEntry"]["position"] for item in layers], [1, 2, 3])
        self.assertTrue(all(item["stack"]["number"] == 72 and item["stack"]["size"] == 3
                            for item in layers))

    def test_alias_and_node_schema(self):
        body = graphql(["api", "graphql", "-f", "query=query($requested:String!,$available:String!){ requested: search available: search }"])
        self.assertEqual(set(body["data"]), {"requested", "available", "rateLimit"})
        for alias in ("requested", "available"):
            self.assertIn("pageInfo", body["data"][alias])
            for node in body["data"][alias]["nodes"]:
                self.assertIn("totalCount", node["reviewRequests"])
                self.assertIn("statusCheckRollup", node["commits"]["nodes"][0]["commit"])

    def test_waiting_prs_carry_recent_timeline_events(self):
        taylor = next(item for item in REQUESTED if item["number"] == 527)
        events = taylor["timelineItems"]["nodes"]
        self.assertEqual([event["__typename"] for event in events],
                         ["ReadyForReviewEvent", "ReviewRequestedEvent"])
        self.assertEqual(events[1]["requestedReviewer"], {"__typename": "Team", "slug": "mobile"})
        self.assertLess(events[0]["createdAt"], events[1]["createdAt"])
        # Recent relative to the clock, whichever clock that is: with
        # PRMARMOT_DEMO_NOW pinned for fixtures, a fixed date here would be a
        # test of the calendar rather than of the data.
        self.assertGreater(events[1]["createdAt"], ago(99 + 1))
        self.assertLessEqual(events[1]["createdAt"], ago(0))
        drafts = [item for item in AUTHORED + REQUESTED if item["isDraft"]]
        self.assertTrue(drafts and all(not item["timelineItems"]["nodes"] for item in drafts))

    def test_review_prs_span_every_size_band(self):
        def band(item):
            lines, files = item["additions"] + item["deletions"], item["changedFiles"]
            if lines > 400 or files > 30:
                return "large"
            return "small" if lines <= 100 and files <= 10 else "medium"
        self.assertEqual({band(item) for item in REQUESTED + AVAILABLE},
                         {"small", "medium", "large"})
        self.assertTrue(all("changedFiles" in item for item in AUTHORED))

    def test_a_single_pull_request_can_be_followed(self):
        resolved = graphql(["api", "graphql", "-f",
                            "query=query($owner:String!,$name:String!){ repository(owner:$owner, name:$name){ pullRequest(number:415){ id } } }",
                            "-f", "owner=demo-labs", "-f", "name=atlas"])
        pr_id = resolved["data"]["repository"]["pullRequest"]["id"]
