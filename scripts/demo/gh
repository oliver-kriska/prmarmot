        import tempfile
        previous = os.environ.get("PRMARMOT_DEMO_NOW")
        os.environ["PRMARMOT_DEMO_NOW"] = "2026-07-26T12:00:00Z"
        try:
            with tempfile.TemporaryDirectory() as first, tempfile.TemporaryDirectory() as second:
