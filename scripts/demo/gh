def page(nodes):
    return {"pageInfo": {"hasNextPage": False, "endCursor": None}, "nodes": nodes}


def rate(cost):
    return {"limit": 5000, "cost": cost, "remaining": 4937,
            "resetAt": "2026-09-08T18:00:00Z"}


def graphql(args):
    fields = dict(arg.split("=", 1) for i, arg in enumerate(args)
                  if i and args[i - 1] == "-f" and "=" in arg)
    query = fields.get("query", "")
    tracked_ids = [
        arg.split("=", 1)[1]
        for i, arg in enumerate(args)
        if i and args[i - 1] == "-F" and arg.startswith("tracked[]=")
    ]
    all_nodes = AUTHORED + REQUESTED + AVAILABLE
    tracked = [next((node for node in all_nodes if node["id"] == tracked_id), None)
               for tracked_id in tracked_ids]
    search = fields.get("q", fields.get("requested", ""))
    selected_repo = next((part[5:] for part in search.split() if part.startswith("repo:")), None)
    def scoped(nodes):
        return [node for node in nodes
                if selected_repo is None or node["repository"]["nameWithOwner"] == selected_repo]
    if "requested:" in query or "requested: search" in query:
        data = {"rateLimit": rate(5)}
        if "$requested" in query:
            data["requested"] = page(scoped(REQUESTED))
        if "$available" in query:
            data["available"] = page(scoped(AVAILABLE))
        if "$tracked" in query:
            data["tracked"] = tracked
        return {"data": data}
    if "search(query:$q" in query:
        data = {"search": page(scoped(AUTHORED)), "rateLimit": rate(3)}
        if "$tracked" in query:
            data["tracked"] = tracked
        return {"data": data}
    raise ValueError("unrecognized GraphQL operation")


class FixtureTests(unittest.TestCase):
    def test_numbers_are_unique_and_views_are_distinct(self):
        authored = {item["number"] for item in AUTHORED}
        review = {item["number"] for item in REQUESTED + AVAILABLE}
        self.assertEqual(len(authored), 11)
        self.assertTrue(authored.isdisjoint(review))

    def test_native_stack_has_three_ordered_layers(self):
        layers = [item for item in AUTHORED if item["stack"]]
        self.assertEqual([item["stackEntry"]["position"] for item in layers], [1, 2, 3])
        self.assertTrue(all(item["stack"]["number"] == 72 and item["stack"]["size"] == 3
                            for item in layers))

    def test_alias_and_node_schema(self):
        body = graphql(["api", "graphql", "-f", "query=query($requested:String!,$available:String!){ requested: search available: search }"])
        self.assertEqual(set(body["data"]), {"requested", "available", "rateLimit"})
        for alias in ("requested", "available"):
            self.assertIn("pageInfo", body["data"][alias])
            for node in body["data"][alias]["nodes"]:
                self.assertIn("totalCount", node["reviewRequests"])
                self.assertIn("statusCheckRollup", node["commits"]["nodes"][0]["commit"])

    def test_release_fixture_is_stable_and_repository_bound(self):
        tag = "v99.0.0"
        self.assertEqual(
            release_line(tag),
            f"{tag}\thttps://github.com/oliver-kriska/prmarmot/releases/tag/{tag}\tfalse\tfalse",
        )


def release_line(tag):
    return (f"{tag}\thttps://github.com/oliver-kriska/prmarmot/releases/tag/{tag}"
            "\tfalse\tfalse")


def main():
    args = sys.argv[1:]
    if args == ["--self-test"]:
        unittest.main(argv=[sys.argv[0]], verbosity=2)
        return
    try:
        if args == ["api", "user", "--jq", ".login"]:
            root = Path(os.environ["XDG_CONFIG_HOME"])
            if (root / "unauthenticated").exists():
                print("not logged in; run gh auth login", file=sys.stderr)
                raise SystemExit(1)
            if (root / "login-network-error").exists():
                print("network unreachable", file=sys.stderr)
                raise SystemExit(1)
            print("demo-user")
        elif len(args) >= 3 and args[:3] == ["api", "--method", "GET"] and "user/repos" in args:
            print(json.dumps([{"full_name": "demo-labs/atlas"},
                              {"full_name": "demo-labs/mobile"}]))
        elif (len(args) >= 4 and args[:3] == ["api", "--method", "GET"]
              and args[3] == "repos/oliver-kriska/prmarmot/releases/latest"):
            tag = "v99.0.0" if os.environ.get("PRMARMOT_DEMO_UPDATE_AVAILABLE") else "v0.0.0"
            print(release_line(tag))
        elif len(args) >= 2 and args[:2] == ["api", "graphql"]:
            marker = Path(os.environ["XDG_CONFIG_HOME"]) / "fail-next-graphql"
            if marker.exists():
                marker.unlink()
                print("Demo connection interrupted. Retry to load the fictional board.", file=sys.stderr)
                raise SystemExit(1)
            print(json.dumps(graphql(args)))
        else:
            raise ValueError("unexpected gh call")
    except (ValueError, KeyError) as error:
        print(f"fake gh: {error}: {' '.join(args)}", file=sys.stderr)
        raise SystemExit(64)


if __name__ == "__main__":
    main()
