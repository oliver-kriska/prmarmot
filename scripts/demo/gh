    def test_pages_name_the_file_that_holds_them(self):
        files = scenario_files("paged", 1)
        first = files["step1-authored.json"]["data"]["search"]["pageInfo"]
        self.assertTrue(first["hasNextPage"])
        self.assertEqual(first["endCursor"], "authored-p2")
        self.assertIn("step1-authored-p2.json", files)
        second = files["step1-authored-p2.json"]["data"]["search"]["pageInfo"]
        self.assertEqual(second["endCursor"], "authored-p3")
        third = files["step1-authored-p3.json"]["data"]["search"]["pageInfo"]
        self.assertFalse(third["hasNextPage"])
        self.assertIsNone(third["endCursor"])
        numbers = {node["number"] for node in
                   files["step1-authored-p2.json"]["data"]["search"]["nodes"]}
        self.assertTrue(numbers.isdisjoint(
            {node["number"] for node in files["step1-authored.json"]["data"]["search"]["nodes"]}))

    def test_the_deep_scenario_offers_more_pages_than_the_cap_allows(self):
        # core stops at five pages per alias, so the sixth page must exist and
        # must be reachable only by a client that ignores the cap.
        files = scenario_files("deep", 1)
        cursors = ["authored-p2", "authored-p3", "authored-p4", "authored-p5", "authored-p6"]
        self.assertEqual(files["step1-authored.json"]["data"]["search"]["pageInfo"]["endCursor"],
                         cursors[0])
        for current, following in zip(cursors, cursors[1:]):
            page_info = files[f"step1-{current}.json"]["data"]["search"]["pageInfo"]
            self.assertTrue(page_info["hasNextPage"], current)
            self.assertEqual(page_info["endCursor"], following)
        last = files[f"step1-{cursors[-1]}.json"]["data"]["search"]["pageInfo"]
        self.assertFalse(last["hasNextPage"])
        numbers = [node["number"] for cursor in cursors
                   for node in files[f"step1-{cursor}.json"]["data"]["search"]["nodes"]]
        self.assertEqual(len(numbers), len(set(numbers)), "pages must not repeat rows")

