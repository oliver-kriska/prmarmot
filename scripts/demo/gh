def pr(number, title, *, author="demo-user", draft=False, decision="REVIEW_REQUIRED",
       mergeable="MERGEABLE", labels=(), requested=(), reviews=(), unresolved=0,
       ci="SUCCESS", stack=None, repo="demo-labs/atlas"):
    request_nodes = [
        {"requestedReviewer": {"__typename": "User", "login": login}}
        for login in requested
    ]
    review_nodes = [
        {"author": {"login": login}, "state": state,
         "submittedAt": f"2026-08-{day:02d}T12:00:00Z"}
        for day, (login, state) in enumerate(reviews, 1)
    ]
    node = {
        "id": f"PR_demo_{repo.replace('/', '_')}_{number}",
        "url": f"https://github.com/{repo}/pull/{number}",
        "repository": {"nameWithOwner": repo},
        "updatedAt": f"2026-09-{number % 10 + 1:02d}T14:00:00Z",
        "headRefOid": f"head-{repo}-{number}",
        "state": "OPEN",
        "merged": False,
        "latestReview": {"nodes": []},
        "number": number,
        "title": title,
        "isDraft": draft,
        "reviewDecision": decision,
        "mergeable": mergeable,
        "createdAt": f"2026-08-{number % 20 + 1:02d}T09:00:00Z",
        "author": {"login": author},
        "labels": {"nodes": [{"name": label} for label in labels]},
        "reviewRequests": {"totalCount": len(request_nodes), "nodes": request_nodes},
        "reviews": {"nodes": review_nodes},
        "reviewThreads": {"nodes":
            [{"isResolved": False} for _ in range(unresolved)]},
        "commits": {"nodes": [{"commit": {"statusCheckRollup":
            None if ci is None else {"state": ci}}}]},
    }
    if stack:
        stack_number, position = stack
        node["stack"] = {"number": stack_number, "size": 3,
                         "baseRefName": "main"}
        node["stackEntry"] = {"position": position}
    else:
        node["stack"] = None
        node["stackEntry"] = None
    return node


