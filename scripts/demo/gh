def page(nodes):
    return {"pageInfo": {"hasNextPage": False, "endCursor": None}, "nodes": nodes}


# PRMARMOT_DEMO_ROWS=N: N fictional PRs per search, 60 per page, for measuring
# the table at Load-more size. Unset, the screenshot fixtures above are served.
SCALE_PAGE = 60
SCALE_WORDS = ("cache", "sync", "export", "search", "timeline", "session", "import",
               "notification", "workspace", "renderer", "keymap", "settings")
SCALE_LABELS = ("bug", "feature", "docs", "mobile", "performance", "area:ui",
                "area:sync", "needs review", "cla-signed", "good first issue")


def scale_rows():
    try:
        return max(0, int(os.environ.get("PRMARMOT_DEMO_ROWS", "")))
    except ValueError:
        return 0


def scale_nodes(alias, count):
    base = {"authored": 1000, "requested": 3000, "available": 5000}[alias]
    nodes = []
    for i in range(count):
        word = SCALE_WORDS[i % len(SCALE_WORDS)]
        title = f"{word.capitalize()}: {'tighten ' * (i % 4)}handling for case {i}"
        if i % 7 == 0:
            title += " when the connection drops halfway through a long batch"
        nodes.append(pr(
            base + i, title,
            author="demo-user" if alias == "authored" else f"dev{i % 23}",
            draft=i % 17 == 0,
            decision=("APPROVED" if i % 5 == 0 else "CHANGES_REQUESTED" if i % 11 == 0
                      else "REVIEW_REQUIRED"),
            mergeable="CONFLICTING" if i % 13 == 0 else "MERGEABLE",
            labels=tuple(SCALE_LABELS[(i + k) % len(SCALE_LABELS)] for k in range(i % 5)),
            requested={"requested": ("demo-user",), "available": ()}.get(
                alias, ("alex",) if i % 3 else ()),
            reviews=(("sam", "COMMENTED"),) if i % 4 == 0 else (),
            unresolved=i % 6 if i % 6 < 3 else 0,
            ci=("SUCCESS", "FAILURE", "PENDING", None)[i % 4],
            stack=((900 + i // 3, i % 3 + 1) if alias == "authored" and i % 9 < 3 else None),
            repo=("demo-labs/atlas", "demo-labs/mobile", "demo-labs/web")[i % 3],
            waited=(i * 7) % 150,
        ))
        if nodes[-1]["stack"]:
            nodes[-1]["stack"]["number"] = 900 + i // 9
    return nodes


def scale_page(alias, after):
    nodes = scale_nodes(alias, scale_rows())
    start = int(after[1:]) if after and after.startswith("c") else 0
    end = start + SCALE_PAGE
    more = end < len(nodes)
    return {"pageInfo": {"hasNextPage": more, "endCursor": f"c{end}" if more else None},
            "nodes": nodes[start:end]}


def scale_graphql(query, fields):
    data = {"rateLimit": rate(3)}
    aliases = [alias for alias in ("requested", "available") if f"{alias}: search" in query]
    for alias in aliases:
        after = fields.get(f"{alias}After", fields.get("after") if len(aliases) == 1 else None)
        data[alias] = scale_page(alias, after)
    if not aliases and "search(query:$q" in query:
        data["search"] = scale_page("authored", fields.get("after"))
    if "$tracked" in query:
        data["tracked"] = []
    return {"data": data}


def rate(cost):
    return {"limit": 5000, "cost": cost, "remaining": 4937,
            "resetAt": "2026-09-08T18:00:00Z"}


def graphql(args):
    fields = dict(arg.split("=", 1) for i, arg in enumerate(args)
                  if i and args[i - 1] == "-f" and "=" in arg)
    query = fields.get("query", "")
    tracked_ids = [
        arg.split("=", 1)[1]
        for i, arg in enumerate(args)
        if i and args[i - 1] == "-F" and arg.startswith("tracked[]=")
    ]
    all_nodes = AUTHORED + REQUESTED + AVAILABLE
    tracked = [next((node for node in all_nodes if node["id"] == tracked_id), None)
               for tracked_id in tracked_ids]
    if scale_rows() and "search" in query:
        return scale_graphql(query, fields)
    search = fields.get("q", fields.get("requested", ""))
    selected_repo = next((part[5:] for part in search.split() if part.startswith("repo:")), None)
    def scoped(nodes):
        return [node for node in nodes
                if selected_repo is None or node["repository"]["nameWithOwner"] == selected_repo]
    if "requested:" in query or "requested: search" in query:
        data = {"rateLimit": rate(5)}
        if "$requested" in query:
            data["requested"] = page(scoped(REQUESTED))
        if "$available" in query:
            data["available"] = page(scoped(AVAILABLE))
        if "$tracked" in query:
            data["tracked"] = tracked
        return {"data": data}
    if "search(query:$q" in query:
        data = {"search": page(scoped(AUTHORED)), "rateLimit": rate(3)}
        if "$tracked" in query:
            data["tracked"] = tracked
        return {"data": data}
    # `prmarmot-cli watch --pr`: resolve owner/name#number, then follow it.
    if "pullRequest(number:" in query:
        repo = f"{fields.get('owner')}/{fields.get('name')}"
        number = int(query.split("pullRequest(number:", 1)[1].split(")", 1)[0])
        if not any(node["repository"]["nameWithOwner"] == repo for node in all_nodes):
            return {"data": {"repository": None},
                    "errors": [{"type": "NOT_FOUND", "path": ["repository"],
                                "message": f"Could not resolve to a Repository with the name '{repo}'."}]}
        found = next((node for node in all_nodes
                      if node["repository"]["nameWithOwner"] == repo and node["number"] == number), None)
        if found is None:
            return {"data": {"repository": {"pullRequest": None}},
                    "errors": [{"type": "NOT_FOUND", "path": ["repository", "pullRequest"],
                                "message": f"Could not resolve to a PullRequest with the number of {number}."}]}
        return {"data": {"repository": {"pullRequest": {"id": found["id"]}}}}
    if "$tracked" in query and "search" not in query:
        return {"data": {"rateLimit": rate(1), "tracked": tracked}}
    raise ValueError("unrecognized GraphQL operation")


class FixtureTests(unittest.TestCase):
    def test_numbers_are_unique_and_views_are_distinct(self):
        authored = {item["number"] for item in AUTHORED}
        review = {item["number"] for item in REQUESTED + AVAILABLE}
        self.assertEqual(len(authored), 11)
        self.assertTrue(authored.isdisjoint(review))

    def test_native_stack_has_three_ordered_layers(self):
        layers = [item for item in AUTHORED if item["stack"]]
        self.assertEqual([item["stackEntry"]["position"] for item in layers], [1, 2, 3])
        self.assertTrue(all(item["stack"]["number"] == 72 and item["stack"]["size"] == 3
                            for item in layers))

    def test_alias_and_node_schema(self):
        body = graphql(["api", "graphql", "-f", "query=query($requested:String!,$available:String!){ requested: search available: search }"])
        self.assertEqual(set(body["data"]), {"requested", "available", "rateLimit"})
        for alias in ("requested", "available"):
            self.assertIn("pageInfo", body["data"][alias])
            for node in body["data"][alias]["nodes"]:
                self.assertIn("totalCount", node["reviewRequests"])
                self.assertIn("statusCheckRollup", node["commits"]["nodes"][0]["commit"])

    def test_waiting_prs_carry_recent_timeline_events(self):
        taylor = next(item for item in REQUESTED if item["number"] == 527)
        events = taylor["timelineItems"]["nodes"]
        self.assertEqual([event["__typename"] for event in events],
                         ["ReadyForReviewEvent", "ReviewRequestedEvent"])
        self.assertEqual(events[1]["requestedReviewer"], {"__typename": "Team", "slug": "mobile"})
        self.assertLess(events[0]["createdAt"], events[1]["createdAt"])
        self.assertGreater(events[1]["createdAt"], "2026-09-01")
        drafts = [item for item in AUTHORED + REQUESTED if item["isDraft"]]
        self.assertTrue(drafts and all(not item["timelineItems"]["nodes"] for item in drafts))

    def test_a_single_pull_request_can_be_followed(self):
        resolved = graphql(["api", "graphql", "-f",
                            "query=query($owner:String!,$name:String!){ repository(owner:$owner, name:$name){ pullRequest(number:415){ id } } }",
                            "-f", "owner=demo-labs", "-f", "name=atlas"])
        pr_id = resolved["data"]["repository"]["pullRequest"]["id"]
        followed = graphql(["api", "graphql", "-f", "query=query($who:String!,$tracked:[ID!]!){ rateLimit { cost } tracked: nodes(ids:$tracked){ id } }",
                            "-F", f"tracked[]={pr_id}"])
        self.assertEqual([node["number"] for node in followed["data"]["tracked"]], [415])
        missing = graphql(["api", "graphql", "-f",
                           "query=query($owner:String!,$name:String!){ repository(owner:$owner, name:$name){ pullRequest(number:999){ id } } }",
                           "-f", "owner=demo-labs", "-f", "name=atlas"])
        self.assertIsNone(missing["data"]["repository"]["pullRequest"])

    def test_scale_mode_pages_like_load_more(self):
        os.environ["PRMARMOT_DEMO_ROWS"] = "130"
        try:
            first = graphql(["api", "graphql", "-f", "query=query($q:String!){ search(query:$q, first:60) }"])
            self.assertEqual(len(first["data"]["search"]["nodes"]), 60)
            self.assertEqual(first["data"]["search"]["pageInfo"]["endCursor"], "c60")
            both = graphql(["api", "graphql", "-f",
                            "query=query($requested:String!,$requestedAfter:String!,$available:String!,$availableAfter:String!){ requested: search available: search }",
                            "-f", "requestedAfter=c120", "-f", "availableAfter=c60"])
            self.assertEqual(len(both["data"]["requested"]["nodes"]), 10)
            self.assertFalse(both["data"]["requested"]["pageInfo"]["hasNextPage"])
            self.assertTrue(both["data"]["available"]["pageInfo"]["hasNextPage"])
            numbers = [node["number"] for node in scale_nodes("requested", 130)]
            self.assertEqual(len(set(numbers)), 130)
        finally:
            del os.environ["PRMARMOT_DEMO_ROWS"]

    def test_release_fixture_is_stable_and_repository_bound(self):
        tag = "v99.0.0"
        self.assertEqual(
            release_line(tag),
            f"{tag}\thttps://github.com/oliver-kriska/prmarmot/releases/tag/{tag}\tfalse\tfalse",
        )


def release_line(tag):
    return (f"{tag}\thttps://github.com/oliver-kriska/prmarmot/releases/tag/{tag}"
            "\tfalse\tfalse")


def main():
    args = sys.argv[1:]
    if args == ["--self-test"]:
        unittest.main(argv=[sys.argv[0]], verbosity=2)
        return
    try:
        if args == ["api", "user", "--jq", ".login"]:
            root = Path(os.environ["XDG_CONFIG_HOME"])
            if (root / "unauthenticated").exists():
                print("not logged in; run gh auth login", file=sys.stderr)
                raise SystemExit(1)
            if (root / "login-network-error").exists():
                print("network unreachable", file=sys.stderr)
                raise SystemExit(1)
            print("demo-user")
        elif len(args) >= 3 and args[:3] == ["api", "--method", "GET"] and "user/repos" in args:
            print(json.dumps([{"full_name": "demo-labs/atlas"},
                              {"full_name": "demo-labs/mobile"}]))
        elif (len(args) >= 4 and args[:3] == ["api", "--method", "GET"]
              and args[3] == "repos/oliver-kriska/prmarmot/releases/latest"):
            tag = "v99.0.0" if os.environ.get("PRMARMOT_DEMO_UPDATE_AVAILABLE") else "v0.0.0"
            print(release_line(tag))
        elif len(args) >= 2 and args[:2] == ["api", "graphql"]:
            marker = Path(os.environ["XDG_CONFIG_HOME"]) / "fail-next-graphql"
            if marker.exists():
                marker.unlink()
                print("Demo connection interrupted. Retry to load the fictional board.", file=sys.stderr)
                raise SystemExit(1)
            print(json.dumps(graphql(args)))
        else:
            raise ValueError("unexpected gh call")
    except (ValueError, KeyError) as error:
        print(f"fake gh: {error}: {' '.join(args)}", file=sys.stderr)
        raise SystemExit(64)


if __name__ == "__main__":
    main()
