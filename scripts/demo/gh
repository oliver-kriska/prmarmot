def now():
    """The instant everything is relative to.

    `PRMARMOT_DEMO_NOW` (RFC 3339, e.g. `2026-07-26T12:00:00Z`) pins it, which
    is what fixture generation needs: a file that differs on every run is not a
    fixture. Unset, it is the real clock, which is what the screenshots want.
    """
    pinned = os.environ.get("PRMARMOT_DEMO_NOW", "").strip()
    if not pinned:
        return datetime.now(timezone.utc)
    return datetime.strptime(pinned, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)


def ago(hours):
    """A timestamp `hours` before now, so pickup ages read the same any day."""
    at = now() - timedelta(hours=hours)
    return at.strftime("%Y-%m-%dT%H:%M:%SZ")


def pr(number, title, *, author="demo-user", draft=False, decision="REVIEW_REQUIRED",
       mergeable="MERGEABLE", labels=(), requested=(), teams=(), reviews=(), unresolved=0,
       ci="SUCCESS", stack=None, repo="demo-labs/atlas", waited=None, size=None):
    reviewers = [{"__typename": "User", "login": login} for login in requested] + [
        {"__typename": "Team", "slug": slug} for slug in teams
    ]
    request_nodes = [{"requestedReviewer": reviewer} for reviewer in reviewers]
    # Ready for review a little before the requests, which went out `waited`
    # hours ago.
    timeline = []
    if waited is not None and not draft:
        timeline.append({"__typename": "ReadyForReviewEvent",
                         "createdAt": ago(waited + (1 if reviewers else 0))})
        timeline += [{"__typename": "ReviewRequestedEvent", "createdAt": ago(waited),
                      "requestedReviewer": reviewer} for reviewer in reviewers]
    # (additions, deletions, changed files); a stable spread unless given.
    if size is None:
        size = ((number * 37) % 900 + 4, (number * 13) % 200, number % 40 + 1)
    review_nodes = [
        {"author": {"login": login}, "state": state,
         "submittedAt": f"2026-08-{day:02d}T12:00:00Z"}
        for day, (login, state) in enumerate(reviews, 1)
    ]
    node = {
        "id": f"PR_demo_{repo.replace('/', '_')}_{number}",
        "url": f"https://github.com/{repo}/pull/{number}",
        "repository": {"nameWithOwner": repo},
        "updatedAt": f"2026-09-{number % 10 + 1:02d}T14:00:00Z",
        "headRefOid": f"head-{repo}-{number}",
        "state": "OPEN",
        "merged": False,
        "latestReview": {"nodes": []},
        "number": number,
        "title": title,
        "isDraft": draft,
        "reviewDecision": decision,
        "mergeable": mergeable,
        "createdAt": f"2026-08-{number % 20 + 1:02d}T09:00:00Z",
        "additions": size[0],
        "deletions": size[1],
        "changedFiles": size[2],
        "author": {"login": author},
        "labels": {"nodes": [{"name": label} for label in labels]},
        "reviewRequests": {"totalCount": len(request_nodes), "nodes": request_nodes},
        "reviews": {"nodes": review_nodes},
        "reviewThreads": {"nodes":
            [{"isResolved": False} for _ in range(unresolved)]},
        "commits": {"nodes": [{"commit": {"statusCheckRollup":
            None if ci is None else {"state": ci}}}]},
        "timelineItems": {"nodes": timeline},
    }
    if stack:
        stack_number, position = stack
        node["stack"] = {"number": stack_number, "size": 3,
                         "baseRefName": "main"}
        node["stackEntry"] = {"position": position}
    else:
        node["stack"] = None
        node["stackEntry"] = None
    return node


