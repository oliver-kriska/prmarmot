#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "==> Installing Debian build and runtime dependencies"
packages=(
  build-essential
  ca-certificates
  clang
  cmake
  curl
  gh
  git
  libasound2-dev
  libfontconfig-dev
  libglib2.0-dev
  libssl-dev
  libvulkan1
  libwayland-dev
  libx11-xcb-dev
  libxkbcommon-x11-dev
  pkg-config
)

missing_packages=()
for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null | grep -q '^ii '; then
    missing_packages+=("$package")
  fi
done

if ((${#missing_packages[@]})); then
  apt=(apt-get)
  if ((EUID != 0)); then
    apt=(sudo -n apt-get)
  fi
  "${apt[@]}" update
  DEBIAN_FRONTEND=noninteractive "${apt[@]}" install -y --no-install-recommends "${missing_packages[@]}"
else
  echo "    System packages are already installed"
fi

echo "==> Installing the repository's Rust toolchain"
if [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
  curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --no-modify-path
fi

# shellcheck disable=SC1091
source "$HOME/.cargo/env"
rustup set profile minimal
rustup toolchain install stable --component rustfmt --component clippy

profile_marker="# PR Marmot Rust toolchain"
touch "$HOME/.bash_profile"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile"; then
  cat >>"$HOME/.bash_profile" <<'EOF'

# PR Marmot Rust toolchain
if [[ -f "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
fi
EOF
fi

echo "==> Fetching locked Cargo dependencies"
cd "$repo_root"
cargo fetch --locked

echo "==> Orb setup complete"
